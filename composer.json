{
  "name": "runbook/the-runbook-briefings",
  "description": "Editorial RSS-to-briefing workflow for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "lint": "find the-runbook-briefings tests plague-dr-suno-publisher plague-dr-suno-publisher-tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": [
      "php tests/run.php",
      "php plague-dr-suno-publisher-tests/run.php"
    ],
    "test:phpunit": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
